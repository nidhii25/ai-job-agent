# Copy this file to .env and fill in local values. Never commit .env.

# CORS: comma-separated frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage locations (defaults are inside the backend directory)
# DATABASE_PATH=./database.db
# PROFILE_PATH=./profile.json
# UPLOAD_DIR=./uploads
# APPLICATIONS_EXPORT_PATH=./applications.json

# Rotating local logs. Logs avoid contact details, resume text, and API keys,
# but should still be treated as local personal data.
LOG_LEVEL=INFO
# LOG_DIR=./logs
# LOG_MAX_BYTES=2097152
# LOG_BACKUP_COUNT=5

# AI mapping (Gemini; the only provider implemented in this version)
GEMINI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
AI_ENABLED=false
AI_CONFIDENCE_THRESHOLD=0.75
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=2
AI_MAX_FIELDS_PER_RUN=8
# AI-written prose is shown as a review suggestion by default. Set true only if
# you accept auto-submitting generated text without reviewing it first.
AI_AUTO_FILL_GENERATED=false

# Browser automation
BROWSER_HEADLESS=false
BROWSER_CLOSE_DELAY_SECONDS=5
BROWSER_SLOW_MO_MS=0
BROWSER_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
# Persistent Chromium profile (manual login/cookies). Keep this directory local.
# BROWSER_PROFILE_DIR=./browser_profile

# Submission and manual verification waits
# AUTO_SUBMIT sets the default for the Apply-page automatic submission checkbox.
# The user can override it per application. A fill-only run can be submitted later
# with the Resume & Submit button.
AUTO_SUBMIT=true
# SUBMISSION_TIMEOUT_MS is milliseconds; the other two are seconds.
SUBMISSION_TIMEOUT_MS=30000
LOGIN_WAIT_SECONDS=300
CAPTCHA_WAIT_SECONDS=300

# Allow http://localhost and private-network job URLs. Keep false except for
# local testing; it weakens the SSRF guard.
ALLOW_LOCAL_URLS=false
